{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mk-xinone.local/schemas/synthesis.schema.json",
  "title": "mk-xinone.synthesis.v1",
  "type": "object",
  "required": ["schema", "consensus", "disagreements", "verdict_label"],
  "properties": {
    "schema": { "const": "mk-xinone.synthesis.v1" },
    "consensus": {
      "type": "array",
      "items": { "type": "string" }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "summary"],
        "properties": {
          "topic": { "type": "string" },
          "a": { "type": "string" },
          "b": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "blind_spots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verdict_label": { "type": "string" },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}
